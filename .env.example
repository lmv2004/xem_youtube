# --- YouTube Data API v3 ---
YOUTUBE_API_KEY=

# --- Database ---
# Production: Neon / Supabase Postgres connection string.
# Local dev: same Neon dev branch works fine; use Docker Postgres if you prefer.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Production URL (no trailing slash). Vercel injects VERCEL_PROJECT_PRODUCTION_URL
# automatically; for local dev use http://localhost:3000
AUTH_URL=http://localhost:3000

# Google OAuth (optional)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
